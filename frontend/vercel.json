{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/query", "destination": "https://gst-rag-dv7x.onrender.com/query" },
    { "source": "/variants", "destination": "https://gst-rag-dv7x.onrender.com/variants" },
    { "source": "/health", "destination": "https://gst-rag-dv7x.onrender.com/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
